# Copy to .env and fill in. `python app.py` and `docker compose up` both read it.
# Every TESTPREP_<KEY> variable sets Flask config <KEY>. See README → Sign-in.

# Google: https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Redirect URI: http://localhost:5000/auth/google/callback (and https://<your-host>/auth/google/callback)
TESTPREP_GOOGLE_CLIENT_ID=
TESTPREP_GOOGLE_CLIENT_SECRET=

# Microsoft: https://entra.microsoft.com → App registrations → New registration → Web platform
# Redirect URI: http://localhost:5000/auth/microsoft/callback (and https://<your-host>/auth/microsoft/callback)
TESTPREP_MICROSOFT_CLIENT_ID=
TESTPREP_MICROSOFT_CLIENT_SECRET=
# common (work, school and personal accounts), organizations, consumers, or your tenant id
TESTPREP_MICROSOFT_TENANT=common

# Optional: only these addresses and/or domains may sign in, comma-separated. Empty = any account.
# TESTPREP_ALLOWED_EMAILS=you@example.com,example.org

# Behind an HTTPS reverse proxy: trust its X-Forwarded-* headers and send the session cookie over HTTPS only.
# TESTPREP_BEHIND_PROXY=true
# TESTPREP_SESSION_COOKIE_SECURE=true
